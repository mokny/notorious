# Copy this file to .env and adjust values before starting the server.

# Port the Fastify server listens on
PORT=4000

# Path to the SQLite database file (relative to packages/server or absolute)
DATABASE_PATH=../../data/notorious.db

# Directory where uploaded files are stored
FILES_DIR=../../data/files

# Secret used to sign session cookies - generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Marks the session cookie as HTTPS-only. Keep this "false" until you have a
# reverse proxy terminating TLS in front of the app (see docs/DEPLOYMENT.md) -
# browsers silently refuse to store/send a "Secure" cookie over plain HTTP,
# which breaks login. Set to "true" once HTTPS is in place.
COOKIE_SECURE=false

# Web Push (VAPID) keys - generate with: npm run generate-vapid-keys --workspace=packages/server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Origin the frontend is served from (used for CORS in dev; in production the
# server serves the built frontend itself, so this is only needed in dev)
WEB_ORIGIN=http://localhost:5173

# Exact public URL this instance is reachable at (e.g. https://notes.example.com,
# no trailing slash) - required for passkeys to work on a real domain (see
# docs/DEPLOYMENT.md). Falls back to WEB_ORIGIN/localhost when unset, which is
# fine for local dev only.
APP_ORIGIN=

# Audio/video calls (optional, off by default - see docs/DEPLOYMENT.md).
# Media is relayed through Notorious's own embedded SFU over this one TCP
# port - no separate TURN server, no port range. Don't set these by hand -
# run `npm run setup-calls --workspace=packages/server`, which detects your
# public IP and writes them itself.
MEDIA_PORT=4001
MEDIA_ANNOUNCED_IP=

# Max chat messages kept per conversation - oldest messages beyond this are
# deleted whenever a new message is sent. Set to 0 to keep everything.
MESSAGE_RETENTION_LIMIT=1000

# Max width/height (px) images sent as chat attachments are downscaled to,
# in every chat and DM instance-wide. Re-encoded to WebP whenever exceeded;
# already-smaller images and animated images (GIF/APNG/animated WebP) are
# left untouched.
CHAT_IMAGE_MAX_WIDTH=1500
CHAT_IMAGE_MAX_HEIGHT=1500

NODE_ENV=development
