# Copy this file to .env and adjust values before starting the server.

# Port the Fastify server listens on
PORT=4000

# Path to the SQLite database file (relative to packages/server or absolute)
DATABASE_PATH=../../data/notorious.db

# Directory where uploaded files are stored
FILES_DIR=../../data/files

# Secret used to sign session cookies - generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Web Push (VAPID) keys - generate with: npm run generate-vapid-keys --workspace=packages/server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Origin the frontend is served from (used for CORS in dev; in production the
# server serves the built frontend itself, so this is only needed in dev)
WEB_ORIGIN=http://localhost:5173

NODE_ENV=development
