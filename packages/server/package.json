{
  "name": "@notorious/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "generate-vapid-keys": "tsx src/scripts/generateVapidKeys.ts",
    "create-user": "tsx src/scripts/createUser.ts",
    "create-user:prod": "node dist/scripts/createUser.js",
    "set-registration": "tsx src/scripts/setRegistration.ts",
    "set-registration:prod": "node dist/scripts/setRegistration.js",
    "set-require-2fa": "tsx src/scripts/setRequire2fa.ts",
    "set-require-2fa:prod": "node dist/scripts/setRequire2fa.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.1",
    "@notorious/shared": "*",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fractional-indexing": "^3.2.0",
    "mdast-util-to-string": "^4.0.0",
    "node-cron": "^3.0.3",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unzipper": "^0.12.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.9.3",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/unzipper": "^0.10.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
